---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { useTranslations, getLocalizedPath, getCvPath, langParams, type Lang } from '../../i18n/utils';
import { getSkillIconId } from '../../utils/techIcons';

export function getStaticPaths() {
  return langParams();
}

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const skillCategories = [
  {
    titleKey: 'about.skills_languages',
    skills: ['C#', 'C++', 'Go', 'TypeScript', 'Python', 'C']
  },
  {
    titleKey: 'about.skills_frameworks',
    skills: ['ASP.NET Core', 'Vue.js', 'Astro.js', 'Qt Framework', 'Entity Framework', 'PyTorch', 'OpenCV']
  },
  {
    titleKey: 'about.skills_data_messaging',
    skills: ['SQL Server', 'RabbitMQ']
  },
  {
    titleKey: 'about.skills_tools_os',
    skills: ['Git', 'Docker', 'CMake', 'Arch Linux (AUR)']
  }
];
const aboutIntroText = t('about.intro').replace(/<[^>]*>/g, '');
---

<Base titlePage={t('about.title')} description={aboutIntroText} lang={lang}>

  <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" media="print" onload="this.media='all'">
  <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async defer></script>
  
  <h1>{t('about.title')}</h1>

  <!-- Foto de bancada presa diretamente pelo percevejo (tachinha) -->
  <div class="pinned-photo-container">
    <!-- Tachinha / Percevejo no topo (fixo na prancha) -->
    <div class="drafting-pin" aria-hidden="true">
      <svg class="pushpin-svg" width="30" height="30" viewBox="0 0 32 32" fill="none">
        <defs>
          <radialGradient id="pin-head-grad" cx="38%" cy="35%" r="65%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.85" />
            <stop offset="25%" stop-color="var(--accent-color)" stop-opacity="0.9" />
            <stop offset="70%" stop-color="var(--accent-color)" stop-opacity="1" />
            <stop offset="100%" stop-color="#1a1410" stop-opacity="1" />
          </radialGradient>
          <filter id="pin-shadow" x="-30%" y="-30%" width="180%" height="180%">
            <feDropShadow dx="1.5" dy="2.5" stdDeviation="2" flood-color="#000000" flood-opacity="0.45" />
          </filter>
        </defs>
        <g filter="url(#pin-shadow)">
          <circle cx="16" cy="15" r="9.5" fill="url(#pin-head-grad)" stroke="color-mix(in srgb, var(--text-color) 40%, transparent)" stroke-width="0.8" />
          <circle cx="16" cy="15" r="6.8" stroke="rgba(255,255,255,0.45)" stroke-width="0.7" fill="none" />
          <circle cx="16" cy="15" r="4.6" fill="url(#pin-head-grad)" />
          <circle cx="13.8" cy="12.8" r="1.3" fill="#ffffff" opacity="0.9" />
        </g>
      </svg>
    </div>

    <!-- A foto suspensa diretamente pelo pino -->
    <div class="photo-card">
      <Image
        src="/me.jpg" 
        alt="João Pedro" 
        loading="eager"
        height={200} 
        width={200}
        class="profile-image"
      />
    </div>
  </div>

  <p set:html={t('about.intro')} />

  <h2>{t('about.current_experience_title')}</h2>
  <p set:html={t('about.current_experience_text')} />

  <div class="experience-cta">
    <a href={getLocalizedPath('/experience', lang)} class="cta-link">{t('about.see_full_experience')}</a>
  </div>

  <h2>{t('about.skills_title')}</h2>
  <div class="skills-grid">
    {skillCategories.map(category => (
      <div class="skills-category">
        <h3>{t(category.titleKey as any)}</h3>
        <div class="skills-tags">
          {category.skills.map(tech => {
            const iconId = getSkillIconId(tech);
            return (
              <span class="skill-tag">
                {iconId && (
                  <img 
                    src={`https://skillicons.dev/icons?i=${iconId}`} 
                    alt="" 
                    class="skill-icon" 
                    width="14" 
                    height="14" 
                    loading="lazy" 
                  />
                )}
                <span>{tech}</span>
              </span>
            );
          })}
        </div>
      </div>
    ))}
  </div>

  <h2>{t('about.outside_code_title')}</h2>
  <p>{t('about.outside_code_text')}</p>

  <h2>{t('about.lets_talk_title')}</h2>
  <p>{t('about.lets_talk_text')}</p>
  
  <div style="margin-top: 2rem; text-align: center; display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
    <a class="download-button" href={getCvPath(lang)} download>{t('about.download_cv')}</a>
    <a class="download-button secondary" href="" onclick="Calendly.initPopupWidget({url: 'https://calendly.com/oliveira-joao-unifesp/30min'});return false;">{t('about.schedule_call')}</a>
  </div>

</Base>

<style>
/* Pinned Photo (Foto presa diretamente pela tachinha de prancha) */
.pinned-photo-container {
  float: right;
  margin: 0.2rem 0 1.5rem 1.8rem;
  position: relative;
  width: fit-content;
  padding-top: 14px;
  z-index: 2;
  user-select: none;
}

.drafting-pin {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  width: 30px;
  height: 30px;
  pointer-events: none;
}

/* Sem borda branca: só a imagem pura suspensa e oscilando no pino */
.photo-card {
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 2px;
  overflow: hidden;
  box-shadow: 0 6px 22px rgba(0, 0, 0, 0.16), 0 2px 5px rgba(0, 0, 0, 0.08);
  transform-origin: 50% 0px;
  transform: rotate(-2.5deg);
  transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.35s ease;
}

:root.dark .photo-card {
  box-shadow: 0 8px 26px rgba(0, 0, 0, 0.55), 0 2px 6px rgba(0, 0, 0, 0.35);
}

.pinned-photo-container:hover .photo-card {
  transform: rotate(1.2deg) translateY(1px);
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.2), 0 3px 7px rgba(0, 0, 0, 0.1);
}

:root.dark .pinned-photo-container:hover .photo-card {
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.65), 0 4px 8px rgba(0, 0, 0, 0.4);
}

.profile-image {
  display: block;
  width: 200px;
  height: 200px;
  object-fit: cover;
  border: none;
}


p {
  text-align: justify;
}

h2 {
  margin-top: 2rem;
  margin-bottom: 0.5rem;
  font-size: 1.5rem;
  color: var(--accent-color);
}

.experience-cta {
  margin: 1.5rem 0 0.5rem 0;
  text-align: center;
}

.cta-link {
  display: inline-block;
  padding: 0.6rem 1.5rem;
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--accent-color);
  text-decoration: none;
  background: color-mix(in srgb, var(--accent-color) 8%, transparent);
  border: 1px solid color-mix(in srgb, var(--accent-color) 20%, transparent);
  border-radius: 6px;
  transition: all 0.2s ease;
  letter-spacing: 0.02em;
}

.cta-link:hover {
  background: color-mix(in srgb, var(--accent-color) 15%, transparent);
  border-color: var(--accent-color);
  transform: translateY(-1px);
}

/* Skills section styling */
.skills-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
  margin: 1.5rem 0 2rem 0;
}

.skills-category {
  background: color-mix(in srgb, var(--text-color) 2%, transparent);
  border: 1px dashed color-mix(in srgb, var(--text-color) 15%, transparent);
  padding: 1.2rem;
  border-radius: 0;
}

.skills-category h3 {
  font-family: Courier, "Courier New", Monaco, monospace;
  font-size: 0.9rem;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--accent-color);
  margin: 0 0 0.8rem 0;
  letter-spacing: 0.5px;
  border-bottom: 3px double color-mix(in srgb, var(--text-color) 15%, transparent);
  padding-bottom: 0.5rem;
}

.skills-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.skill-tag {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.2rem 0.5rem;
  font-family: Courier, "Courier New", Monaco, monospace;
  font-size: 0.75rem;
  font-weight: 500;
  background: color-mix(in srgb, var(--text-color) 4%, transparent);
  border: 1px solid color-mix(in srgb, var(--text-color) 8%, transparent);
  color: var(--text-color);
}

.skill-icon {
  width: 14px;
  height: 14px;
  object-fit: contain;
}

.download-button {
  padding: 0.6rem 1.5rem;
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--text-color);
  opacity: 0.8;
  text-decoration: none;
  background: transparent;
  border: 1px solid color-mix(in srgb, var(--text-color) 15%, transparent);
  border-radius: 6px;
  transition: all 0.2s ease;
  letter-spacing: 0.02em;
  display: inline-block;
}

.download-button:hover {
  opacity: 1;
  background: color-mix(in srgb, var(--text-color) 5%, transparent);
  border-color: color-mix(in srgb, var(--text-color) 25%, transparent);
  transform: translateY(-1px);
}

.download-button.secondary {
  background: var(--accent-color);
  color: var(--background-color);
  border-color: var(--accent-color);
  opacity: 1;
}

.download-button.secondary:hover {
  background: var(--accent-hover);
  border-color: var(--accent-hover);
  color: var(--background-color);
}

@media (max-width: 768px) {
  .skills-grid {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
}

@media (max-width: 768px) {
  .pinned-photo-container {
    float: none;
    margin: 1rem auto 2.2rem auto;
    display: flex;
    justify-content: center;
    width: fit-content;
  }

  h1 {
    text-align: center;
  }

  h2 {
    font-size: 1.3rem;
    margin-top: 1.5rem;
  }

  .experience-cta {
    margin: 1rem 0 0.5rem 0;
  }

  .cta-link {
    padding: 0.5rem 1.2rem;
    font-size: 0.9rem;
  }

  .download-button {
    padding: 0.5rem 1.2rem;
    font-size: 0.85rem;
  }
}

@media (max-width: 480px) {
  .profile-image {
    width: 180px;
    height: 180px;
  }

  h2 {
    font-size: 1.2rem;
  }

  p {
    font-size: 0.95rem;
  }
}
</style>
