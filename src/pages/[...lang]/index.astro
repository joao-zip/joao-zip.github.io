---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { useTranslations, langParams, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return langParams();
}

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<Base titlePage={t('nav.home')} lang={lang}>

  <section id="hero">
    <div>
      <h1>{t('home.greeting')}</h1>
      <span>{t('home.tagline')}</span>
    </div>

    <Image src="/svg/ink.svg" alt={t('home.ink_alt')} width={150} height={150} loading="eager" class="hero-logo" />
  </section>
</Base>

<style>

.hero-logo {
  transition: filter 0.3s ease;
}

:global(:root.dark) .hero-logo,
:global(.dark) .hero-logo {
  filter: brightness(0) invert(1);
}

#hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
}

div {
    text-align: justify;
}

h1 {
  margin: 0;
  font-size: 4rem;
}

span {
  font-family: "Italianno", cursive;
  font-size: 3rem;
}

.zip {
  font-family: "Inter", serif;
  font-size: 2rem;
}

@media (max-width: 768px) {
  #hero {
    flex-direction: column-reverse;
    text-align: center;
    gap: 1.5rem;
    padding: 1rem 0;
  }

  div {
    text-align: center;
  }

  h1 {
    font-size: 2.5rem;
  }

  span {
    font-size: 2rem;
  }
}

@media (max-width: 480px) {
  h1 {
    font-size: 2rem;
  }

  span {
    font-size: 1.7rem;
  }
}
</style>
