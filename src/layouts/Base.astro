---
interface Props {
  titlePage?: string;
  description?: string;
  image?: string;
  lang?: Lang;
  noindex?: boolean;
}

const { titlePage, description, image, lang = 'pt', noindex = false } = Astro.props as Props;

import { ViewTransitions } from 'astro:transitions';
import { useTranslations, type Lang } from '../i18n/utils';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AIChatWidget from '../components/AIChatWidget.astro';

const t = useTranslations(lang as Lang);
const htmlLang = lang === 'pt' ? 'pt-BR' : 'en';

const siteUrl = Astro.site ?? new URL('https://joao-zip.github.io');
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

const pageTitle = titlePage ? `joao.zip | ${titlePage}` : 'joao.zip';
const metaTitle = titlePage ? `${titlePage} | João Pedro` : t('meta.og_title');
const metaDescription = description || t('meta.description');
const socialImageURL = new URL(image || '/og-image.png', siteUrl);

const cleanPath = Astro.url.pathname.replace(/^\/en(\/|$)/, '/');
const ptAlternate = new URL(cleanPath, siteUrl).href;
const enAlternate = new URL(`/en${cleanPath === '/' ? '/' : cleanPath}`, siteUrl).href;

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://joao-zip.github.io/#website",
      "url": "https://joao-zip.github.io/",
      "name": "joao.zip",
      "description": "Portfólio e projetos de software de João Pedro",
      "inLanguage": ["pt-BR", "en"]
    },
    {
      "@type": "Person",
      "@id": "https://joao-zip.github.io/#person",
      "name": "João Pedro",
      "url": "https://joao-zip.github.io/",
      "image": new URL('/me.jpg', siteUrl).href,
      "jobTitle": lang === 'pt' ? "Desenvolvedor de Software" : "Software Developer",
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "Universidade Federal de São Paulo (UNIFESP)"
      },
      "sameAs": [
        "https://github.com/joao-zip",
        "https://www.linkedin.com/in/joao-zip/"
      ]
    }
  ]
};
---

<html lang={htmlLang}>
	<head>
	    <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        
        <link rel="canonical" href={canonicalURL.href} />
        
        <title>{pageTitle}</title>
        <meta name="title" content={metaTitle} />
        <meta name="description" content={metaDescription} />
        <meta name="keywords" content="desenvolvedor, fullstack, C++, Python, TypeScript, ASP.NET Core, open-source, portfólio" />
        <meta name="author" content="João Pedro" />
        <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
        
        <!-- Theme color for mobile browsers -->
        <meta name="theme-color" content="#eee" id="meta-theme-color" />
        
        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL.href} />
        <meta property="og:title" content={metaTitle} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:image" content={socialImageURL.href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
        
        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalURL.href} />
        <meta property="twitter:title" content={metaTitle} />
        <meta property="twitter:description" content={metaDescription} />
        <meta property="twitter:image" content={socialImageURL.href} />
        
        <!-- hreflang alternates -->
        <link rel="alternate" hreflang="pt-BR" href={ptAlternate} />
        <link rel="alternate" hreflang="en" href={enAlternate} />
        <link rel="alternate" hreflang="x-default" href={ptAlternate} />

        <!-- Structured Data (JSON-LD) -->
        <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

        <script is:inline>
          (function() {
            function applyTheme() {
              const savedTheme = localStorage.getItem('theme');
              const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
              const theme = savedTheme || (prefersDark ? 'dark' : 'light');
              
              if (theme === 'dark') {
                document.documentElement.classList.add('dark');
              } else {
                document.documentElement.classList.remove('dark');
              }

              const metaThemeColor = document.getElementById('meta-theme-color');
              if (metaThemeColor) {
                metaThemeColor.setAttribute('content', theme === 'dark' ? '#1a1614' : '#eee');
              }
            }
            
            applyTheme();
            
            document.addEventListener('astro:before-swap', applyTheme);
            document.addEventListener('astro:after-swap', applyTheme);
          })();
        </script>
        
        <ViewTransitions />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=Italianno&display=swap" rel="stylesheet">
	    <link rel="icon" type="image/svg+xml" href="/svg/ink.svg" />
      <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
      <link rel="manifest" href="/site.webmanifest" />
	</head>
    <body>
        <Header lang={lang} />
        <main transition:animate="slide">
            <slot />
        </main>
        <Footer lang={lang} />
        <AIChatWidget lang={lang} />
	</body>
</html>

<style is:global>
:root {
    /* Light mode */
    --light-bg: #eee;
    --light-text: #241d19;
    --light-accent: #4C392F;
    --light-accent-hover: #3d2e26;
    
    /* Dark mode */
    --dark-bg: #1a1614;
    --dark-text: #e8e6e3;
    --dark-accent: #8b7355;
    --dark-accent-hover: #a08568;
    
    /* Active theme colors (default light) */
    --background-color: var(--light-bg);
    --text-color: var(--light-text);
    --accent-color: var(--light-accent);
    --accent-hover: var(--light-accent-hover);
    --selection-bg: var(--light-accent);
    --selection-text: var(--light-bg);
}

/* Dark mode */
:root.dark {
    --background-color: var(--dark-bg);
    --text-color: var(--dark-text);
    --accent-color: var(--dark-accent);
    --accent-hover: var(--dark-accent-hover);
    --selection-bg: var(--dark-accent);
    --selection-text: var(--dark-bg);
}

*::selection {
    background-color: var(--selection-bg);
    color: var(--selection-text);
}

body {
    margin: 0px;
    font-family: "Crimson Text", serif;
    font-size: 20px;
    background-color: var(--background-color);
    color: var(--text-color);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100vh;
    align-items: center;
}

body.theme-transitioning {
    transition: background-color 0.3s ease, color 0.3s ease;
}

main {
    width: 70vw;
    max-width: 1200px;
    padding: 0 1rem;
    box-sizing: border-box;
}

p {
    text-align: justify;
}

a {
    text-decoration: none;
    color: var(--text-color);
}

li {
    list-style-type: none;
}

code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: 0.85em;
    background-color: color-mix(in srgb, var(--text-color) 8%, transparent);
    padding: 0.15em 0.4em;
    border-radius: 3px;
}

pre {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: 0.85em;
    background-color: color-mix(in srgb, var(--text-color) 6%, transparent);
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
}

pre code {
    background-color: transparent;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
}

/* Mobile responsiveness */
@media (max-width: 768px) {
    body {
        font-size: 18px;
    }
    
    main {
        width: 92vw;
        padding: 0 0.5rem;
    }
}

@media (max-width: 480px) {
    body {
        font-size: 16px;
    }
    
    main {
        width: 95vw;
    }
}
</style>
